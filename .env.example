# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# TMDB — free key at https://developer.themoviedb.org/  (posters + metadata)
# Leave blank to run in stub mode (everything works except metadata/posters).
TMDB_API_KEY=

# Flask session secret — set to any long random string.
FLASK_SECRET=change-me-in-production

# qBittorrent Web UI (optional — for one-click send-to-qBittorrent)
QBT_URL=http://localhost:8080
QBT_USERNAME=admin
QBT_PASSWORD=adminadmin

# Optional overrides
# ADDON_HOST=0.0.0.0
# ADDON_PORT=7000
# COMPANION_PORT=7001
# ADDON_PUBLIC_URL=http://your-lan-ip:7000
# STREMIO_AUTH_KEY=            # auto-detected if blank

# ── Stream sources (all optional) ──
# JACKETT_URL=http://127.0.0.1:9117       # blank = reuse qBittorrent's jackett.json
# JACKETT_API_KEY=
# UPSTREAM_STREAM_ADDONS=https://torrentio.strem.fun   # comma-separated
# TRACKERS_URL=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt
# MAX_STREAM_TRACKERS=40
# MIN_STREAM_SEEDS=1
